{
  "manifest_version": 3,
  "name": "LeekWallet Zcash",
  "version": "0.1.0",
  "description": "A Zcash wallet in the browser: Orchard and Ironwood, synced and proven locally. Signing on the LeekWallet board comes next.",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "LeekWallet Zcash",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": ["offscreen", "storage", "unlimitedStorage"],
  "host_permissions": [
    "https://zcash-testnet.chainsafe.dev/*",
    "https://zcash-mainnet.chainsafe.dev/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "cross_origin_embedder_policy": { "value": "require-corp" },
  "cross_origin_opener_policy": { "value": "same-origin" },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
