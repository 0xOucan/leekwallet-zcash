{
  "name": "leekwallet-zcash-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LeekWallet Zcash as a Chrome MV3 extension: the chrome/engine WASM wallet in an offscreen document's worker, signing on the LeekWallet board over USB, Bluetooth or QR",
  "license": "Apache-2.0",
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test test/board.test.mjs test/qr.test.mjs && node test/e2e.mjs",
    "test:board": "node --test test/board.test.mjs",
    "test:e2e": "node test/e2e.mjs",
    "test:broadcast": "BROADCAST=1 node test/e2e.mjs",
    "test:qr": "node --test test/qr.test.mjs"
  },
  "devDependencies": {
    "playwright-core": "1.63.0"
  },
  "dependencies": {
    "@noble/ciphers": "1.3.0",
    "qrcode-generator": "2.0.4",
    "zxing-wasm": "3.1.3"
  },
  "overrides": {
    "@types/emscripten": "1.41.5",
    "type-fest": "5.10.0"
  }
}
